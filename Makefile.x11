CC = gcc
CFLAGS = -g -DGFX_X11
LDFLAGS = -lX11 -lpthread -lm

SOURCES = main.c graphics.c config.c plot.c ringbuf.c threading.c ini_parser.c datasource.c httpd.c ds/snmp_client.c ds/ping.c ds/tcp.c ds/cpu.c ds/memory.c ds/snmp.c ds/if_thr.c ds/loadavg.c ds/shell.c ds/clock.c os/os.c
OBJECTS = $(SOURCES:.c=.o)
TARGET = sng

# Auto detect OS
all:
	@s=`uname -s`; r=`uname -r`; v=`uname -v`; m=`uname -m`; \
	case "$$s" in \
	  Linux)   t=linux;; \
	  SunOS)   t=solaris;; \
	  AIX)     t=aix;; \
	  OSF1)    t=osf1;; \
	  HP-UX)   case "$$r" in \
	             *.10.*) t=hpux10;; \
	             *.11.31*) case "$$m" in ia64) t=hpux1131ia64;; *) t=hpux;; esac;; \
	             *) t=hpux;; \
	           esac;; \
	  IRIX*)   case "$$r" in 5.*) t=irix5;; *) t=irix;; esac;; \
	  UnixWare|UNIX_SV) t=unixware;; \
	  SCO_SV)  case "$$v" in 6.*) t=osr6;; *) echo "OpenServer $$v is not supported"; exit 1;; esac;; \
	  Darwin)  echo "use Makefile.macos on macOS"; exit 1;; \
	  *) echo "$$s not known here, building with the defaults"; t=$(TARGET);; \
	esac; \
	echo "=> make $$t"; \
	$(MAKE) -f Makefile.x11 $$t

$(TARGET): $(OBJECTS)
	$(CC) $(OBJECTS) -o $(TARGET) $(LDFLAGS)

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

# SysV make ignores the pattern rule above and its built-in .c.o drops the
# object in the current directory, which breaks the ds/ and os/ subdirectories.
.SUFFIXES: .c .o
.c.o:
	$(CC) $(CFLAGS) -c $< -o $@

linux:
	$(MAKE) -f Makefile.x11 CFLAGS="-g -DGFX_X11 -DLINUX" LDFLAGS="-lX11 -lpthread -lm" $(TARGET)

solaris:
	$(MAKE) -f Makefile.x11 CFLAGS="-g -DGFX_X11" LDFLAGS="-lX11 -lpthread -lm -lsocket -lnsl -lrt -lkstat -lresolv" $(TARGET)

hpux:
	$(MAKE) -f Makefile.x11 CFLAGS="-g -DGFX_X11" LDFLAGS="-L/usr/lib/X11R6 -lX11 -lpthread -lm -lnm" $(TARGET)

hpux1131ia64:
	$(MAKE) -f Makefile.x11 CC=/opt/ansic/bin/aCC \
	  CFLAGS="-AC99 +O3 +DSitanium2 -mt -DGFX_X11 \
	    -D_XOPEN_SOURCE_EXTENDED -D_HPUX_SOURCE" \
	  LDFLAGS="-mt -L/usr/lib/hpux32 -lX11 -lpthread -lm -lnm" $(TARGET)

# 10.20 has no pthreads and no NMAPI: gcc -threads gives DCE/CMA (-lcma -lc_r)
hpux10:
	$(MAKE) -f Makefile.x11 CFLAGS="-g -DGFX_X11 -DHPUX10 -threads -include os/hpux10.h" LDFLAGS="-L/usr/lib/X11R6 -lX11 -lm -threads" $(TARGET)

aix:
	$(MAKE) -f Makefile.x11 CFLAGS="-g -DGFX_X11 -pthread" LDFLAGS="-lX11 -pthread -lm" $(TARGET)

unixware:
	$(MAKE) -f Makefile.x11 CFLAGS="-g -DGFX_X11 -DUNIXWARE" LDFLAGS="-lX11 -lthread -lm -lsocket -lnsl -lelf -lmas" $(TARGET)

# SCO OpenServer 6: native CCS 4.2 cc, POSIX threads via -Kthread.
osr6:
	$(MAKE) -f Makefile.x11 CC=cc \
	  CFLAGS="-O -Kthread -DGFX_X11 -DOSR6" \
	  LDFLAGS="-Kthread -L/usr/X11R6/lib -lX11 -lsocket -lnsl -lmas -lelf -lm" $(TARGET)

# Compaq C defaults to K&R mode on V4.0, where a # that is not in column 1 is
# ignored, which drops the indented directives in compat.h.  -std is DEC C's
# relaxed ANSI mode.  vm_statistics() lives in libmach, not libc.
osf1:
	$(MAKE) -f Makefile.x11 CC=cc CFLAGS="-std -O2 -DGFX_X11 -pthread" \
	  LDFLAGS="-lX11 -pthread -lm -lmach" $(TARGET)

irix:
	$(MAKE) -f Makefile.x11 CFLAGS="-g -DGFX_X11 -isystem /usr/include -D__STDINT_H__" LDFLAGS="-lX11 -lpthread -lelf" $(TARGET)

IRIX5_GCCLIB = /usr/tgcware/gcc45/lib/gcc/mips-sgi-irix5.3/4.5.3
IRIX5_LD = /usr/tgcware/mips-sgi-irix5.3/bin/ld

irix5:
	$(MAKE) -f Makefile.x11 $(OBJECTS) CFLAGS="-g -DGFX_X11 -DIRIX5 -isystem /usr/include -D__STDINT_H__"
	$(IRIX5_LD) -o $(TARGET) -init __gcc_init -fini __gcc_fini \
	  /usr/lib/crt1.o $(IRIX5_GCCLIB)/irix-crti.o $(IRIX5_GCCLIB)/crtbegin.o \
	  -L$(IRIX5_GCCLIB) -L$(IRIX5_GCCLIB)/../../.. -L/usr/lib \
	  $(OBJECTS) -lX11 -lmld -lgcc -lgcc_eh -lc \
	  $(IRIX5_GCCLIB)/crtend.o $(IRIX5_GCCLIB)/irix-crtn.o /usr/lib/crtn.o

clean:
	rm -f *.o */*.o $(TARGET)

install: $(TARGET)
	cp $(TARGET) /usr/local/bin/

.PHONY: all clean install linux solaris hpux hpux1131ia64 hpux10 aix unixware osr6 osf1 irix irix5
